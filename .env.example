# Postgres (Neon recomendado, tem free tier). Mesma string em dev e produção
# evita qualquer diferença de comportamento entre os dois ambientes.
DATABASE_URL="postgresql://user:pass@host/aurafarming?sslmode=require"

# Gere um valor aleatório longo (ex: openssl rand -hex 32)
SESSION_SECRET="troque-por-um-valor-aleatorio-longo"

NEXT_PUBLIC_SITE_URL="https://aurafarming.com.br"
