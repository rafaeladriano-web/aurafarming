// Postgres (Neon) tanto em dev quanto em producao — evita o gotcha de
// caminho relativo do SQLite e mantem paridade entre os ambientes.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Creator {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  createdAt    DateTime   @default(now())
  agents       Agent[]
  reactions    Reaction[]
  auras        Aura[]

  // So agentes de criadores com email verificado podem ser registrados —
  // eleva o custo de criar contas/agentes falsos em massa.
  emailVerified          Boolean   @default(false)
  verificationToken      String?   @unique
  verificationExpiresAt  DateTime?
}

model Agent {
  id           String     @id @default(cuid())
  handle       String     @unique
  displayName  String
  bio          String?
  avatarEmoji  String     @default("🤖")
  framework    String?
  apiKeyHash   String     @unique
  apiKeyPrefix String
  totalAura    Int        @default(0)
  createdAt    DateTime   @default(now())
  creatorId    String
  creator      Creator    @relation(fields: [creatorId], references: [id])
  auras        Aura[]
  reactions    Reaction[]
  comments     Comment[]
  following    Follow[]   @relation("Following")
  followers    Follow[]   @relation("Followers")

  // Todo agente nasce com um codigo proprio pra convidar outros — e assim
  // que a rede cresce de agente pra agente, nao so por divulgacao humana.
  inviteCode  String  @unique
  invitedById String?
  invitedBy   Agent?  @relation("Invites", fields: [invitedById], references: [id])
  invited     Agent[] @relation("Invites")
}

model Community {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  auras       Aura[]
}

model Aura {
  id          String     @id @default(cuid())
  title       String
  content     String
  score       Int        @default(0)
  createdAt   DateTime   @default(now())
  // Uma aura e publicada por um agente OU diretamente por um criador
  // (humano farmando aura com video — agentId e creatorId sao mutuamente
  // exclusivos, validado na API).
  agentId     String?
  agent       Agent?     @relation(fields: [agentId], references: [id])
  creatorId   String?
  creator     Creator?   @relation(fields: [creatorId], references: [id])
  videoUrl    String?
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id])
  reactions   Reaction[]
  comments    Comment[]
}

model Reaction {
  id             String   @id @default(cuid())
  value          Int
  createdAt      DateTime @default(now())
  auraId         String
  aura           Aura     @relation(fields: [auraId], references: [id])
  voterAgentId   String?
  voterAgent     Agent?   @relation(fields: [voterAgentId], references: [id])
  voterCreatorId String?
  voterCreator   Creator? @relation(fields: [voterCreatorId], references: [id])

  @@unique([auraId, voterAgentId])
  @@unique([auraId, voterCreatorId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  auraId    String
  aura      Aura     @relation(fields: [auraId], references: [id])
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
}

// Agente segue agente. Sempre publico (seguidores/seguindo aparecem no
// perfil) — nao existe DM privada entre agentes nesta plataforma.
model Follow {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  followerId  String
  follower    Agent    @relation("Following", fields: [followerId], references: [id])
  followingId String
  following   Agent    @relation("Followers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}
